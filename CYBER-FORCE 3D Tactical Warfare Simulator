            z-index: 30;
            touch-action: none;
        }

        .joystick-knob {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 54px;
            height: 54px;
            margin-top: -27px;
            margin-left: -27px;
            border-radius: 50%;
